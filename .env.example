# Copy to .env, then: chmod 600 .env
# Mainnet only. Two keys are enough for a test run.

# --- Keys -------------------------------------------------------------------
# Defendant: owns the ERC-8004 identity, the askbots payout wallet and the buy wallet.
# Falls back to PRIVATE_KEY if unset. Fund with 0.2 CELO and 1 USD₮.
AGENT_PRIVATE_KEY=
# Counterparty: witness, arbitrator, jury and askbots builder in one.
# Falls back to PRIVATE_KEY_2 if unset. Must differ from the defendant.
# Fund with 1 CELO and 2 USD₮.
COUNTERPARTY_PRIVATE_KEY=
# Optional: split the counterparty into distinct roles. Each falls back to COUNTERPARTY_PRIVATE_KEY.
WITNESS_PRIVATE_KEY=
# Kleros decides the ruling; the arbitrator key only relays it into ERC-8004 on Celo. Leave it unset:
# it falls back to the counterparty, which works as long as SHADY_PRIVATE_KEY below is a wallet of its own.
ARBITRATOR_PRIVATE_KEY=
JURY_PRIVATE_KEY=
BUILDER_PRIVATE_KEY=
# Shady provider: owns the shady ERC-8004 identity and receives the junk sale. Give it a wallet of its
# own (fund with 0.05 CELO for pnpm shady:register): the registry refuses feedback from an agent's
# owner, and the counterparty relays the ruling on the shady provider. Falls back to
# COUNTERPARTY_PRIVATE_KEY, which breaks that ruling. SHADY_PAY_TO falls back to this key's address.
SHADY_PRIVATE_KEY=
SHADY_PAY_TO=

# --- Identities (filled after the first run) ---------------------------------
# The defendant's ERC-8004 agent id. Leave empty on the first run; act 1 mints and prints it.
AGENT_ID=
# The shady provider's ERC-8004 agent id. pnpm shady:register prints it.
SHADY_AGENT_ID=

# --- Services -----------------------------------------------------------------
# x402 facilitator API key for the shady paywall. Create at https://x402.celo.org
# Falls back to x402_API_KEY if unset.
BUY_FACILITATOR_API_KEY=
# Anthropic. The defendant is a Claude agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# askbots: the defendant's agent credentials file (created by act 1) and the cron secret.
ASKBOTS_CREDS=.runs/askbots-agent.json
ASKBOTS_CRON_SECRET=
ASKBOTS_BASE_URL=https://askbots.ai
# Celo RPC
CELO_RPC_URL=https://forno.celo.org

# --- Run ------------------------------------------------------------------
# test | show. Picks the courtroom round id.
TRIAL_ENV=test
# Courtroom (the public live log, evidence board, vote). Leave empty to run without it.
COURTROOM_URL=
HOST_SECRET=
# ERC-8021 builder code tagged onto every tx we sign. Default: derived from COURTROOM_URL's hostname.
BUILDER_CODE=
# buy state directory (accounts, receipts). Keep it inside the repo so runs are reproducible.
BUY_HOME=.runs/buy
# Where buy keeps the defendant's signing key: system (the OS keychain; the only one buy 0.8 accepts on
# mainnet) | file (plaintext, development only). pnpm preflight imports the agent key once.
BUY_KEYSTORE_BACKEND=system

# --- Storage adapter (Swarm plug-in) ----------------------------------------
# local | swarm
STORAGE=local
BEE_API_URL=https://api.gateway.ethswarm.org
SWARM_POSTAGE_BATCH_ID=
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
SWARM_FEED_PRIVATE_KEY=

# --- Dispute adapter (Kleros plug-in) ---------------------------------------
# local | kleros. kleros files through the Kleros Dispute Service (docs/PLUG-IN-KLEROS.md).
DISPUTE=local
# One key per deployment, issued by Kleros. KLEROS_CHAIN picks which one is used, so
# both can sit here. The key, not KLEROS_CHAIN, decides where a dispute is filed;
# KLEROS_CHAIN must match it (pnpm check:kleros says when it does not).
# Testnet (demo-testnet): arbitrum-sepolia-testnet, court 8, 1 juror, test data.
KLEROS_API_KEY_TESTNET=
# Beta (demo-beta): arbitrum-one, court 34, 5 jurors. Live production: real,
# permanent, public cases. Never show or hand this key to an audience.
KLEROS_API_KEY_BETA=
# arbitrum-sepolia-testnet (Testnet) | arbitrum-one (Beta)
KLEROS_CHAIN=arbitrum-sepolia-testnet
# 1 to allow filing on arbitrum-one. "Beta" is the release name, not a test network.
KLEROS_ALLOW_BETA=
# Alias slots. Unset: the x402 purchase dispute's own, buyer (complainant) and provider (respondent).
KLEROS_ALIAS_COMPLAINANT=
KLEROS_ALIAS_RESPONDENT=
# Template answer value -> winner (complainant | respondent | refused), with the answer's title pinned.
# These are the x402 purchase dispute's answers (both keys). 0 and ties are always refused.
KLEROS_RULING_MAP=1=complainant:Accept the claim,2=respondent:Reject the claim
# <chain>:<core id>, comma separated, of disputes whose answers you confirmed on the Court page (degraded reads).
KLEROS_CONFIRMED_ANSWERS=
# vote: the ruling once the vote is over, taken as final (an appeal is not waited for). executed: once executed.
KLEROS_WAIT_FOR=vote
# 0 to skip publishing the juror attachment to IPFS (evidence_pin is permanent and public).
KLEROS_PIN_ATTACHMENT=1
# When the instructions do not name one chain: the fingerprint pnpm check:kleros prints, once you have read them.
KLEROS_TRUST_PRESET=
# Optional
KLEROS_SERVICE_URL=https://kleros-dispute-service.fly.dev/mcp
KLEROS_POLL_MS=30000
KLEROS_COURT_URL=
KLEROS_STATE_FILE=.runs/kleros/disputes.json
# How long pnpm rehearse waits for the Kleros ruling (ms).
KLEROS_REHEARSE_WAIT_MS=5400000
